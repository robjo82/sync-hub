node_modules/
dist/
# The whole data dir, not just *.sqlite* — it's real conversation content (the DB, its WAL/SHM
# files, ad hoc backups like hub.sqlite.backup_reorg, archived-sessions/) and must never end up in
# a public repo. Nothing under here is meant to be shared or reproduced by a fresh clone.
data/
*.log
.DS_Store
imports/chatgpt/*
imports/claude/*
!imports/chatgpt/.gitkeep
!imports/claude/.gitkeep

# Regenerated by the daemon itself for whichever local ~/Projets it's pointed at — never something
# to version, and would immediately go stale/conflict for anyone running their own instance.
/CLAUDE.md
/AGENTS.md
