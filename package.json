{
  "name": "sync-hub",
  "version": "0.1.0",
  "description": "Centralise en local, verbatim, l'historique de tes conversations IA (Claude Code, Codex, imports Claude.ai/ChatGPT) et l'expose via un dashboard et un serveur MCP.",
  "repository": {
    "type": "git",
    "url": "https://github.com/robjo82/sync-hub.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server/index.js",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1",
    "gpt-tokenizer": "^4.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
